{
  "name": "apicalls",
  "version": "0.1.0",
  "description": "Outbound HTTP/SDK call extractor for TypeScript repositories",
  "keywords": [
    "typescript",
    "static-analysis",
    "api",
    "http",
    "sdk",
    "openapi",
    "inventory",
    "cli"
  ],
  "homepage": "https://github.com/okapi-hq/api-grep#readme",
  "bugs": {
    "url": "https://github.com/okapi-hq/api-grep/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/okapi-hq/api-grep.git"
  },
  "type": "module",
  "license": "MIT",
  "author": "Okapi",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "apicalls": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema.json": "./schema/report.v1.json"
  },
  "files": [
    "dist",
    "registry",
    "schema"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests eval scripts --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "node --max-old-space-size=8192 --import tsx eval/run.ts",
    "eval:score": "tsx eval/score.ts",
    "gen:registry": "tsx scripts/gen-registry.ts",
    "gen:schema": "tsx scripts/gen-schema.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^10.1.0",
    "@openapi-contrib/openapi-schema-to-json-schema": "^5.1.0",
    "ajv": "^8.17.1",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0",
    "fast-glob": "^3.3.3",
    "openapi-types": "^12.1.3",
    "picocolors": "^1.1.1",
    "simple-git": "^3.27.0",
    "ts-morph": "^25.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^22.13.10",
    "axios": "^1.20.0",
    "eslint": "^9.22.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "openai": "^7.12.1",
    "stripe": "^22.6.1",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vitest": "^3.0.8"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --max-warnings 0 --no-warn-ignored"
    ]
  }
}
