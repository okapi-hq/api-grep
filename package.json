{
  "name": "apicalls",
  "version": "0.1.0",
  "description": "Outbound HTTP/SDK call extractor for TypeScript repositories",
  "keywords": [
    "typescript",
    "static-analysis",
    "api",
    "http",
    "sdk",
    "openapi",
    "inventory",
    "cli"
  ],
  "homepage": "https://github.com/okapi-hq/api-grep#readme",
  "bugs": {
    "url": "https://github.com/okapi-hq/api-grep/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/okapi-hq/api-grep.git"
  },
  "type": "module",
  "license": "MIT",
  "author": "Okapi",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "apicalls": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema.json": "./schema/report.v1.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && vitest run --config vitest.e2e.config.ts",
    "eval": "node --max-old-space-size=8192 --import tsx eval/run.ts",
    "eval:score": "tsx eval/score.ts",
    "gen:registry": "tsx scripts/gen-registry.ts",
    "gen:schema": "tsx scripts/gen-schema.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^10.1.0",
    "ajv": "^8.17.1",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0",
    "fast-glob": "^3.3.3",
    "openapi-types": "^12.1.3",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.7",
    "ts-morph": "^25.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.13.10",
    "@types/picomatch": "^4.0.3",
    "axios": "^1.20.0",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "openai": "^7.30.1",
    "stripe": "^22.6.1",
    "tsup": "^8.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --max-warnings 0 --no-warn-ignored"
    ]
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@>=2.0.0 <2.1.7": "^2.1.7",
      "brace-expansion@>=4.0.0 <5.0.12": "^5.0.12",
      "fast-uri@<3.1.8": "^3.1.8",
      "source-map-js@<1.2.2": "^1.2.2",
      "undici@<6.28.1": "^6.28.1"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm"
      ]
    }
  }
}
