{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/okapi-hq/api-grep/main/schema/report.v1.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "URL of this JSON Schema."
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$",
      "description": "Version of the report format. Readers check the major; minor versions only add fields and enum values."
    },
    "tool": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "description": "Version of the tool that wrote the report."
    },
    "repo": {
      "description": "Name of the scanned directory.",
      "type": "string"
    },
    "commit": {
      "description": "HEAD commit of the scanned directory, when it is a git repository.",
      "type": "string"
    },
    "calls": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Call"
      },
      "description": "Sorted by file, line and column."
    },
    "stats": {
      "$ref": "#/definitions/Stats"
    },
    "diagnostics": {
      "$ref": "#/definitions/Diagnostics"
    },
    "coverage": {
      "$ref": "#/definitions/Coverage"
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "tool",
    "version",
    "calls",
    "stats"
  ],
  "title": "api-grep report",
  "description": "Outbound HTTP and SDK calls found in a codebase by `apicalls scan --json`.",
  "definitions": {
    "Call": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable id: a hash of file, line and column. Each other request made from the same place (through a wrapper) adds its index."
        },
        "location": {
          "$ref": "#/definitions/Location"
        },
        "client": {
          "$ref": "#/definitions/Client"
        },
        "sdk": {
          "description": "Set when client is sdk.",
          "type": "object",
          "properties": {
            "package": {
              "type": "string"
            },
            "version": {
              "description": "Version range from the nearest manifest (package.json, requirements file, pyproject.toml...).",
              "type": "string"
            },
            "chain": {
              "type": "string",
              "description": "Method called on the client (`customers.create`)."
            }
          },
          "required": [
            "package",
            "chain"
          ]
        },
        "framework": {
          "description": "Framework helper (n8n, activepieces, ...), when client is framework.",
          "type": "string"
        },
        "provider": {
          "type": "string",
          "description": "Provider id from `apicalls providers` (`stripe`), or `internal` (relative URL, localhost), `env:<NAME>` or `unknown`."
        },
        "providerSource": {
          "description": "sdk: the SDK registry. host: a known host. env-name: only the env var's name.",
          "type": "string",
          "enum": [
            "sdk",
            "host",
            "env-name"
          ]
        },
        "host": {
          "description": "Host, possibly with placeholders (`{project}.supabase.co`). Absent when unknown.",
          "type": "string"
        },
        "hostKind": {
          "type": "string",
          "enum": [
            "literal",
            "const",
            "env",
            "relative",
            "unknown"
          ],
          "description": "Where the host came from."
        },
        "envName": {
          "description": "Env var holding the base URL, when hostKind is env.",
          "type": "string"
        },
        "scheme": {
          "type": "string"
        },
        "method": {
          "type": "string",
          "description": "HTTP method, upper case; `DYNAMIC` when it is not known statically."
        },
        "pathTemplate": {
          "type": "string",
          "description": "Path with `{name}` placeholders for the dynamic segments."
        },
        "urlTemplate": {
          "type": "string",
          "description": "Full URL template."
        },
        "operationId": {
          "description": "OpenAPI operation id, from the SDK registry or a matched spec.",
          "type": "string"
        },
        "query": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Query parameter names."
        },
        "queryShape": {
          "$ref": "#/definitions/Shape"
        },
        "headers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Header names, lower case."
        },
        "headerValues": {
          "default": {},
          "description": "Literal header values; null for credentials and dynamic values.",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "authScheme": {
          "type": "string",
          "enum": [
            "bearer",
            "apikey",
            "basic",
            "none",
            "unknown"
          ]
        },
        "body": {
          "$ref": "#/definitions/Shape"
        },
        "bodyFromType": {
          "description": "TypeScript type the body was read from.",
          "type": "string"
        },
        "bodyEncoding": {
          "type": "string",
          "enum": [
            "json",
            "form",
            "multipart",
            "raw",
            "none"
          ]
        },
        "dynamic": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DynamicPart"
          }
        },
        "via": {
          "description": "Wrapper chain the call went through (`wrapper:tlsFetch>doFetch`); the location is the outer call site.",
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "0 to 1. How sure the scan is of provider, URL and body."
        },
        "findings": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/Finding"
          }
        },
        "examples": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/Example"
          }
        }
      },
      "required": [
        "id",
        "location",
        "client",
        "provider",
        "hostKind",
        "method",
        "pathTemplate",
        "urlTemplate",
        "query",
        "headers",
        "headerValues",
        "authScheme",
        "bodyEncoding",
        "dynamic",
        "confidence",
        "findings",
        "examples"
      ],
      "description": "One outbound HTTP or SDK call found in the source."
    },
    "Location": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "description": "Path relative to the scanned directory, `/` separated."
        },
        "line": {
          "type": "number",
          "description": "1-based line of the call."
        },
        "col": {
          "type": "number",
          "description": "1-based column of the call."
        },
        "language": {
          "$ref": "#/definitions/Language"
        }
      },
      "required": [
        "file",
        "line",
        "col",
        "language"
      ],
      "description": "Where the call is in the source."
    },
    "Language": {
      "type": "string",
      "enum": [
        "typescript",
        "javascript",
        "python",
        "php"
      ],
      "description": "Source language of a file, from its extension. The TypeScript front end emits typescript and javascript, the Python one python, the PHP one php."
    },
    "Client": {
      "type": "string",
      "enum": [
        "fetch",
        "axios",
        "got",
        "ky",
        "node-http",
        "requests",
        "httpx",
        "aiohttp",
        "urllib",
        "urllib3",
        "guzzle",
        "laravel-http",
        "symfony-http",
        "curl",
        "psr-18",
        "php-stream",
        "wordpress",
        "sdk",
        "framework"
      ],
      "description": "How the request is sent. TypeScript: fetch, axios, got, ky, node-http. Python: requests, httpx, aiohttp, urllib (urllib.request), urllib3. PHP: guzzle, laravel-http (the Http facade), symfony-http (HttpClient), curl, psr-18 (a PSR-7 request sent by any PSR-18 client), php-stream (file_get_contents / fopen on a URL), wordpress (wp_remote_*). Any language: sdk (a registry), framework (a framework helper)."
    },
    "Shape": {
      "description": "Shape of a value: names and types, never data. `fromType` is the TypeScript type it was read from. Close to JSON Schema, plus `dynamic` and `unknown`.",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "object"
            },
            "properties": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "$ref": "#/definitions/Shape"
              }
            },
            "required": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "dynamicKeys": {
              "description": "Some keys are computed and not listed.",
              "type": "boolean"
            },
            "fromType": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "properties",
            "required"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "array"
            },
            "items": {
              "$ref": "#/definitions/Shape"
            },
            "fromType": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "items"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "string",
                "number",
                "integer",
                "boolean",
                "null"
              ]
            },
            "enum": {
              "description": "Literal values seen in the code.",
              "type": "array",
              "items": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              }
            },
            "fromType": {
              "type": "string"
            },
            "hint": {
              "description": "Source identifier the value came from (`email`), used to synthesize examples.",
              "type": "string"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "union"
            },
            "anyOf": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Shape"
              }
            },
            "fromType": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "anyOf"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "dynamic"
            },
            "origin": {
              "type": "string",
              "enum": [
                "param",
                "call",
                "env",
                "unknown"
              ],
              "description": "Where the value comes from: a parameter, a call result, an env var, or unknown."
            },
            "hint": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "origin"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "unknown"
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    },
    "DynamicPart": {
      "type": "object",
      "properties": {
        "where": {
          "type": "string",
          "enum": [
            "path",
            "query",
            "body",
            "method",
            "host"
          ]
        },
        "name": {
          "type": "string",
          "description": "Placeholder name, as in `{name}` in `pathTemplate`."
        },
        "origin": {
          "type": "string",
          "description": "param, call, env, sdk or unknown."
        },
        "shape": {
          "$ref": "#/definitions/Shape"
        }
      },
      "required": [
        "where",
        "name",
        "origin"
      ],
      "description": "Part of the request the scan could not know statically."
    },
    "Finding": {
      "type": "object",
      "properties": {
        "rule": {
          "type": "string",
          "enum": [
            "unknown-property",
            "missing-required",
            "type-mismatch",
            "deprecated",
            "enum-mismatch"
          ]
        },
        "severity": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "property": {
          "type": "string",
          "description": "Dotted path of the property in the body."
        },
        "message": {
          "type": "string"
        },
        "specRef": {
          "description": "JSON pointer into the OpenAPI spec.",
          "type": "string"
        }
      },
      "required": [
        "rule",
        "severity",
        "property",
        "message"
      ],
      "description": "A mismatch between the body shape and the provider's OpenAPI spec (--specs --validate)."
    },
    "Example": {
      "type": "object",
      "properties": {
        "variant": {
          "type": "string",
          "enum": [
            "minimal",
            "full",
            "alt"
          ],
          "description": "minimal: required properties. full: adds optional ones. alt: other enum values, union branches and booleans."
        },
        "method": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "description": "Concrete URL; an unresolved host stays visible (`https://{baseUrl}/...`)."
        },
        "headers": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          },
          "description": "Credentials are `<name>` placeholders, never values."
        },
        "query": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "body": {},
        "bodyEncoding": {
          "type": "string",
          "enum": [
            "json",
            "form",
            "multipart",
            "raw",
            "none"
          ]
        }
      },
      "required": [
        "variant",
        "method",
        "url",
        "headers",
        "query",
        "bodyEncoding"
      ],
      "description": "A concrete request synthesized from the call: invented values, stable across runs."
    },
    "Stats": {
      "type": "object",
      "properties": {
        "filesScanned": {
          "type": "number"
        },
        "callsFound": {
          "type": "number"
        },
        "byLanguage": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "number"
          },
          "description": "Calls per source language."
        },
        "byClient": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "number"
          },
          "description": "Calls per client."
        },
        "byProvider": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "number"
          },
          "description": "Calls per provider."
        },
        "byHostKind": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "number"
          },
          "description": "Calls per hostKind."
        },
        "withBodyShape": {
          "type": "number"
        },
        "withDynamic": {
          "type": "number"
        },
        "withFindings": {
          "type": "number"
        },
        "redacted": {
          "type": "number",
          "description": "Secret-looking strings replaced with `<redacted>`."
        },
        "durationMs": {
          "type": "number"
        }
      },
      "required": [
        "filesScanned",
        "callsFound",
        "byLanguage",
        "byClient",
        "byProvider",
        "byHostKind",
        "withBodyShape",
        "withDynamic",
        "withFindings",
        "redacted",
        "durationMs"
      ],
      "description": "Counts over `calls`."
    },
    "Diagnostics": {
      "type": "object",
      "properties": {
        "filesSeen": {
          "type": "number",
          "description": "Source files in scope. Test files, mocks, declarations and build output are out of scope."
        },
        "filesScanned": {
          "type": "number"
        },
        "skipped": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SkippedFile"
          },
          "description": "Files left out. Above 200, files left out by --exclude / --include are only counted in `skippedCounts`."
        },
        "skippedCounts": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "number"
          },
          "description": "Skipped files per reason."
        },
        "droppedCalls": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DroppedCall"
          }
        },
        "unfollowed": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/UnfollowedCall"
          }
        },
        "languages": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "filesSeen": {
                "type": "number"
              },
              "filesScanned": {
                "type": "number"
              }
            },
            "required": [
              "filesSeen",
              "filesScanned"
            ]
          },
          "description": "Files seen and scanned per language, for the languages with files in scope."
        },
        "complete": {
          "type": "boolean",
          "description": "False when something was lost that was not asked for: an unreadable file, a dropped call or a call not followed."
        }
      },
      "required": [
        "filesSeen",
        "filesScanned",
        "skipped",
        "skippedCounts",
        "droppedCalls",
        "unfollowed",
        "languages",
        "complete"
      ],
      "description": "What the scan could not read, so a partial report never looks complete."
    },
    "SkippedFile": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "description": "Path relative to the scanned directory."
        },
        "reason": {
          "type": "string",
          "enum": [
            "parse-error",
            "internal-error",
            "excluded",
            "not-included"
          ],
          "description": "parse-error / internal-error: the file could not be read. excluded / not-included: left out by --exclude / --include."
        },
        "detail": {
          "description": "First line of the error, when there is one.",
          "type": "string"
        }
      },
      "required": [
        "file",
        "reason"
      ],
      "description": "A source file in scope that was not scanned."
    },
    "DroppedCall": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": "number"
        },
        "reason": {
          "type": "string",
          "enum": [
            "schema-invalid",
            "internal-error"
          ],
          "description": "schema-invalid: the call did not fit this schema. internal-error: the resolver threw."
        },
        "detail": {
          "description": "For schema-invalid, the failing property path and message.",
          "type": "string"
        }
      },
      "required": [
        "file",
        "line",
        "reason"
      ],
      "description": "A call that was found but left out of `calls`."
    },
    "UnfollowedCall": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": "number"
        },
        "reason": {
          "type": "string",
          "enum": [
            "injected-fetch",
            "injected-client",
            "wrapper-depth"
          ],
          "description": "injected-fetch: a fetch function received from outside (`this.fetchFn(url)`). injected-client: an HTTP client object received without a type that names it (`self.session.post(url)`). wrapper-depth: a wrapper three or more hops from its HTTP call."
        },
        "expr": {
          "description": "The callee expression, for injected-fetch and injected-client.",
          "type": "string"
        },
        "via": {
          "description": "The wrapper called, for wrapper-depth.",
          "type": "string"
        }
      },
      "required": [
        "file",
        "line",
        "reason"
      ],
      "description": "A call site the scan saw but could not follow to a request."
    },
    "Coverage": {
      "type": "object",
      "properties": {
        "sdks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SdkCoverage"
          }
        }
      },
      "required": [
        "sdks"
      ],
      "description": "API SDKs the repository declares or imports. Absent for --changed-since scans."
    },
    "SdkCoverage": {
      "type": "object",
      "properties": {
        "package": {
          "type": "string",
          "description": "Package name in its ecosystem: an npm package, a PyPI distribution, a Composer package."
        },
        "ecosystem": {
          "$ref": "#/definitions/Ecosystem"
        },
        "provider": {
          "type": "string",
          "description": "Provider id the package talks to."
        },
        "supported": {
          "type": "boolean",
          "description": "An SDK registry exists for the package, so its calls can be listed."
        },
        "declared": {
          "type": "boolean",
          "description": "Declared in a manifest the scan covered: `dependencies` / `peerDependencies` of a package.json, a requirements file, pyproject.toml, Pipfile, setup.cfg or setup.py, `require` of a composer.json."
        },
        "imported": {
          "type": "boolean"
        },
        "importSites": {
          "type": "number",
          "description": "Scanned files that import the package (type-only imports aside)."
        },
        "calls": {
          "type": "number",
          "description": "Calls in `calls` made through this package."
        },
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "unsupported",
            "imported-no-calls",
            "declared-not-imported"
          ],
          "description": "ok: supported and calls found. unsupported: imported, no registry (its calls are missed). imported-no-calls: supported but no call found (a wrapper, or a detection bug). declared-not-imported: likely unused."
        }
      },
      "required": [
        "package",
        "ecosystem",
        "provider",
        "supported",
        "declared",
        "imported",
        "importSites",
        "calls",
        "status"
      ],
      "description": "An API SDK the repository uses, compared with the calls found through it."
    },
    "Ecosystem": {
      "type": "string",
      "enum": [
        "npm",
        "pypi",
        "composer"
      ],
      "description": "Package registry of an SDK: npm (package.json), pypi (requirements files, pyproject.toml, Pipfile, setup.cfg / setup.py), composer (composer.json)."
    }
  }
}
