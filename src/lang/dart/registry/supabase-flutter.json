{
  "$comment": "supabase_flutter and supabase (Dart): `Supabase.instance.client`, or a `SupabaseClient(url, key)`. `instance` and `client` lead to the client and `schema(name)` only switches the Postgres schema: builders, left out of the keys. `from(table)` and `storage.from(bucket)` name what the verb after them works on (`from.select`); filters after it are the same request. The base URL is the `url:` of the project's `Supabase.initialize(...)`, or the first constructor argument.",
  "package": "supabase_flutter",
  "aliases": ["supabase"],
  "imports": ["supabase_flutter.Supabase", "supabase_flutter.SupabaseClient", "supabase.SupabaseClient"],
  "provider": "supabase",
  "host": "{project}.supabase.co",
  "auth": "bearer",
  "generatedFrom": "manual (checked against supabase_flutter 2.8, supabase 2.6, postgrest 2.4, gotrue 2.11, storage_client 2.3, functions_client 2.4)",
  "instance": { "names": ["SupabaseClient"], "urlArg": { "SupabaseClient": "0|kw:supabaseUrl" } },
  "setupUrl": { "calls": ["Supabase.initialize"], "host": "kw:url" },
  "inlinePathLiterals": true,
  "builders": ["instance", "client", "schema"],
  "methods": {
    "from.select": { "method": "GET", "path": "/rest/v1/{table}", "params": { "table": "instance:0" } },
    "from.insert": { "method": "POST", "path": "/rest/v1/{table}", "params": { "table": "instance:0" }, "bodyArg": 0 },
    "from.upsert": { "method": "POST", "path": "/rest/v1/{table}", "params": { "table": "instance:0" }, "bodyArg": 0 },
    "from.update": { "method": "PATCH", "path": "/rest/v1/{table}", "params": { "table": "instance:0" }, "bodyArg": 0 },
    "from.delete": { "method": "DELETE", "path": "/rest/v1/{table}", "params": { "table": "instance:0" } },
    "rpc": { "method": "POST", "path": "/rest/v1/rpc/{fn}", "params": { "fn": "arg:0" }, "bodyKw": "params" },
    "functions.invoke": { "method": "POST", "path": "/functions/v1/{function_name}", "params": { "function_name": "arg:0" }, "bodyKw": "body" },
    "auth.getUser": { "method": "GET", "path": "/auth/v1/user" },
    "auth.updateUser": { "method": "PUT", "path": "/auth/v1/user", "bodyArg": 0 },
    "auth.signUp": { "method": "POST", "path": "/auth/v1/signup", "bodyKwargs": true },
    "auth.signInAnonymously": { "method": "POST", "path": "/auth/v1/signup", "bodyKwargs": true },
    "auth.signInWithPassword": { "method": "POST", "path": "/auth/v1/token?grant_type=password", "bodyKwargs": true },
    "auth.signInWithIdToken": { "method": "POST", "path": "/auth/v1/token?grant_type=id_token", "bodyKwargs": true },
    "auth.refreshSession": { "method": "POST", "path": "/auth/v1/token?grant_type=refresh_token" },
    "auth.exchangeCodeForSession": { "method": "POST", "path": "/auth/v1/token?grant_type=pkce" },
    "auth.signInWithOtp": { "method": "POST", "path": "/auth/v1/otp", "bodyKwargs": true },
    "auth.verifyOTP": { "method": "POST", "path": "/auth/v1/verify", "bodyKwargs": true },
    "auth.signInWithSSO": { "method": "POST", "path": "/auth/v1/sso", "bodyKwargs": true },
    "auth.resend": { "method": "POST", "path": "/auth/v1/resend", "bodyKwargs": true },
    "auth.resetPasswordForEmail": { "method": "POST", "path": "/auth/v1/recover" },
    "auth.reauthenticate": { "method": "GET", "path": "/auth/v1/reauthenticate" },
    "auth.signOut": { "method": "POST", "path": "/auth/v1/logout" },
    "storage.from.upload": { "method": "POST", "path": "/storage/v1/object/{bucket}/{path}", "params": { "bucket": "instance:0", "path": "arg:0" }, "bodyArg": 1, "encoding": "multipart" },
    "storage.from.uploadBinary": { "method": "POST", "path": "/storage/v1/object/{bucket}/{path}", "params": { "bucket": "instance:0", "path": "arg:0" }, "bodyArg": 1, "encoding": "multipart" },
    "storage.from.update": { "method": "PUT", "path": "/storage/v1/object/{bucket}/{path}", "params": { "bucket": "instance:0", "path": "arg:0" }, "bodyArg": 1, "encoding": "multipart" },
    "storage.from.updateBinary": { "method": "PUT", "path": "/storage/v1/object/{bucket}/{path}", "params": { "bucket": "instance:0", "path": "arg:0" }, "bodyArg": 1, "encoding": "multipart" },
    "storage.from.download": { "method": "GET", "path": "/storage/v1/object/{bucket}/{path}", "params": { "bucket": "instance:0", "path": "arg:0" } },
    "storage.from.remove": { "method": "DELETE", "path": "/storage/v1/object/{bucket}", "params": { "bucket": "instance:0" } },
    "storage.from.list": { "method": "POST", "path": "/storage/v1/object/list/{bucket}", "params": { "bucket": "instance:0" } },
    "storage.from.move": { "method": "POST", "path": "/storage/v1/object/move" },
    "storage.from.copy": { "method": "POST", "path": "/storage/v1/object/copy" },
    "storage.from.createSignedUrl": { "method": "POST", "path": "/storage/v1/object/sign/{bucket}/{path}", "params": { "bucket": "instance:0", "path": "arg:0" } },
    "storage.from.createSignedUrls": { "method": "POST", "path": "/storage/v1/object/sign/{bucket}", "params": { "bucket": "instance:0" } },
    "storage.listBuckets": { "method": "GET", "path": "/storage/v1/bucket" },
    "storage.getBucket": { "method": "GET", "path": "/storage/v1/bucket/{id}", "params": { "id": "arg:0" } },
    "storage.createBucket": { "method": "POST", "path": "/storage/v1/bucket" },
    "storage.emptyBucket": { "method": "POST", "path": "/storage/v1/bucket/{id}/empty", "params": { "id": "arg:0" } },
    "storage.deleteBucket": { "method": "DELETE", "path": "/storage/v1/bucket/{id}", "params": { "id": "arg:0" } }
  }
}
