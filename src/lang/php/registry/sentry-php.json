    "SentrySdk.getCurrentHub.captureException": {"method": "POST", "path": "/api/{projectId}/envelope/"},
    "SentrySdk.getCurrentHub.captureMessage": {"method": "POST", "path": "/api/{projectId}/envelope/"},
    "SentrySdk.getCurrentHub.captureEvent": {"method": "POST", "path": "/api/{projectId}/envelope/"},
    "SentrySdk.getCurrentHub.captureLastError": {"method": "POST", "path": "/api/{projectId}/envelope/"},
    "SentrySdk.getCurrentHub.captureCheckIn": {"method": "POST", "path": "/api/{projectId}/envelope/"}
