  "aliases": [
    "sentry/sentry-laravel",
    "sentry/sentry-symfony"
  ],
  "imports": [
    "Sentry",
    "Sentry.Laravel.Facade",
    "Sentry.Laravel.Integration"
  ],
  "provider": "sentry",
