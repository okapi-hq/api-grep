{
  "$comment": "Python HTTP clients. `functions` are both module functions (`requests.get`) and methods of the client objects built by `instances` (`requests.Session().get`, `httpx.AsyncClient(base_url=...).post`). `keys` maps keyword arguments to what they carry.",
  "clients": [
    {
      "client": "requests",
      "imports": ["requests"],
      "instances": { "names": ["Session", "session"] },
      "functions": {
        "get": { "method": "GET", "queryArg": 1 },
        "head": { "method": "HEAD" },
        "options": { "method": "OPTIONS" },
        "delete": { "method": "DELETE" },
        "post": { "method": "POST", "bodyArg": 1, "bodyRole": "body:form" },
        "put": { "method": "PUT", "bodyArg": 1, "bodyRole": "body:form" },
        "patch": { "method": "PATCH", "bodyArg": 1, "bodyRole": "body:form" },
        "request": { "methodArg": 0, "urlArg": 1 }
      },
      "keys": { "url": "url", "method": "method", "params": "query", "json": "body:json", "data": "body:form", "files": "body:multipart", "headers": "headers", "auth": "auth" }
    },
    {
      "client": "requests",
      "imports": ["requests_hardened"],
