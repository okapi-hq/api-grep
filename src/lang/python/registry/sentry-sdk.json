    "get_current_scope.capture_event": {"method": "POST", "path": "/api/{projectId}/envelope/"},
    "get_isolation_scope.capture_exception": {"method": "POST", "path": "/api/{projectId}/envelope/"},
    "get_isolation_scope.capture_message": {"method": "POST", "path": "/api/{projectId}/envelope/"},
    "Hub.current.capture_exception": {"method": "POST", "path": "/api/{projectId}/envelope/"},
    "Hub.current.capture_message": {"method": "POST", "path": "/api/{projectId}/envelope/"},
    "Hub.current.capture_event": {"method": "POST", "path": "/api/{projectId}/envelope/"}
  }
