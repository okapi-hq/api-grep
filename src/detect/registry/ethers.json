{
  "$comment": "ethers v5 and v6 (#52): a JsonRpcProvider sends JSON-RPC to the URL it is built with. A BrowserProvider (v5 Web3Provider) talks to the wallet and a WebSocketProvider over a socket: calls through them are not HTTP requests of the app. `rpc` is the method on the wire. A Contract (#78) sends what its runner can: a provider only reads (`eth_call`), a Wallet signs in the app (`eth_sendRawTransaction`), `provider.getSigner()` has the node sign (`eth_sendTransaction`); a function called directly is a view or a transaction as the ABI written in the code says, either when it does not. `*` in a key is one of the ABI's functions, never one of `notFunctions`.",
  "package": "ethers",
  "aliases": ["@ethersproject/providers", "@ethersproject/contracts"],
  "provider": "json-rpc",
  "host": "{rpcEndpoint}",
  "auth": "unknown",
  "generatedFrom": "manual (checked against ethers 5.7 and 6.13)",
  "inlinePathLiterals": true,
  "instance": { "names": ["JsonRpcProvider", "StaticJsonRpcProvider"] },
  "endpoint": {
    "clients": {
      "JsonRpcProvider": { "url": "0" },
      "StaticJsonRpcProvider": { "url": "0" }
    },
    "nonHttp": ["BrowserProvider", "Web3Provider", "WebSocketProvider", "IpcProvider", "IpcSocketProvider", "SocketProvider"],
    "types": ["JsonRpcProvider", "StaticJsonRpcProvider", "Provider", "AbstractProvider", "BaseProvider", "JsonRpcApiProvider"],
    "signers": { "Wallet": { "provider": "1", "signs": "local" }, "getSigner": { "signs": "node" } }
  },
  "notFunctions": ["addListener", "address", "attach", "callStatic", "connect", "deployed", "deploymentTransaction", "emit", "estimateGas", "fallback", "filters", "functions", "getAddress", "getDeployedCode", "getEvent", "getFunction", "interface", "listenerCount", "listeners", "off", "on", "once", "populateTransaction", "provider", "queryFilter", "removeAllListeners", "removeListener", "resolvedAddress", "runner", "signer", "target", "then", "toString", "valueOf", "waitForDeployment"],
  "methods": {
    "Contract.*": { "method": "POST", "path": "", "contract": "auto", "runnerArg": "2", "abiArg": "1" },
    "Contract.functions.*": { "method": "POST", "path": "", "contract": "auto", "runnerArg": "2", "abiArg": "1" },
    "Contract.*.send": { "method": "POST", "path": "", "contract": "send", "runnerArg": "2" },
    "Contract.*.staticCall": { "method": "POST", "path": "", "rpc": "eth_call", "runnerArg": "2" },
    "Contract.callStatic.*": { "method": "POST", "path": "", "rpc": "eth_call", "runnerArg": "2" },
    "Contract.*.estimateGas": { "method": "POST", "path": "", "rpc": "eth_estimateGas", "runnerArg": "2" },
    "Contract.estimateGas.*": { "method": "POST", "path": "", "rpc": "eth_estimateGas", "runnerArg": "2" },
    "Contract.queryFilter": { "method": "POST", "path": "", "rpc": "eth_getLogs", "runnerArg": "2" },
    "broadcastTransaction": { "method": "POST", "path": "", "rpc": "eth_sendRawTransaction" },
    "call": { "method": "POST", "path": "", "rpc": "eth_call", "bodyArg": 0 },
    "estimateGas": { "method": "POST", "path": "", "rpc": "eth_estimateGas", "bodyArg": 0 },
    "getBalance": { "method": "POST", "path": "", "rpc": "eth_getBalance" },
    "getBlock": { "method": "POST", "path": "", "rpc": ["eth_getBlockByNumber", "eth_getBlockByHash"] },
    "getBlockNumber": { "method": "POST", "path": "", "rpc": "eth_blockNumber" },
    "getBlockWithTransactions": { "method": "POST", "path": "", "rpc": ["eth_getBlockByNumber", "eth_getBlockByHash"] },
    "getCode": { "method": "POST", "path": "", "rpc": "eth_getCode" },
    "getGasPrice": { "method": "POST", "path": "", "rpc": "eth_gasPrice" },
    "getLogs": { "method": "POST", "path": "", "rpc": "eth_getLogs", "bodyArg": 0 },
    "getNetwork": { "method": "POST", "path": "", "rpc": "eth_chainId" },
    "getStorage": { "method": "POST", "path": "", "rpc": "eth_getStorageAt" },
    "getStorageAt": { "method": "POST", "path": "", "rpc": "eth_getStorageAt" },
    "getTransaction": { "method": "POST", "path": "", "rpc": "eth_getTransactionByHash" },
    "getTransactionCount": { "method": "POST", "path": "", "rpc": "eth_getTransactionCount" },
    "getTransactionReceipt": { "method": "POST", "path": "", "rpc": "eth_getTransactionReceipt" },
    "listAccounts": { "method": "POST", "path": "", "rpc": "eth_accounts" },
    "send": { "method": "POST", "path": "", "rpcArg": "0", "bodyArg": 1 },
    "sendTransaction": { "method": "POST", "path": "", "rpc": "eth_sendRawTransaction" },
    "waitForTransaction": { "method": "POST", "path": "", "rpc": "eth_getTransactionReceipt" }
  }
}
