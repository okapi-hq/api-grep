    "subscribe": { "method": "POST", "path": "", "documentArg": 0, "bodyArg": 0, "bodyProp": "variables", "subscription": true },
    "useQuery": { "method": "POST", "path": "", "documentArg": 0, "bodyArg": 1, "bodyProp": "variables", "clientArg": "1.client" },
    "useLazyQuery": { "method": "POST", "path": "", "documentArg": 0, "bodyArg": 1, "bodyProp": "variables", "clientArg": "1.client" },
    "useSuspenseQuery": { "method": "POST", "path": "", "documentArg": 0, "bodyArg": 1, "bodyProp": "variables", "clientArg": "1.client" },
    "useBackgroundQuery": { "method": "POST", "path": "", "documentArg": 0, "bodyArg": 1, "bodyProp": "variables", "clientArg": "1.client" },
    "useMutation": { "method": "POST", "path": "", "documentArg": 0, "bodyArg": 1, "bodyProp": "variables", "clientArg": "1.client" },
