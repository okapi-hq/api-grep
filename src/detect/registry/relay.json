{
  "$comment": "Relay (#67) talks to the endpoint of its network layer: `new Environment({ network: Network.create(fetchFn) })`, where `fetchFn` is the app's own function and the URL is that of the one `fetch` it sends. Hooks name no environment, and the one `commitMutation` / `fetchQuery` are given is the app's: the project's one network layer, else the endpoint is unknown. #83 adds `loadQuery(environment, query, variables)`, the refetch query of `createRefetchContainer` and the pagination query of `createPaginationContainer`, and `<QueryRenderer environment query variables />` (a JSX component: `components`, its props as arguments). #92 adds the `loadQuery` function `useQueryLoader(query)` returns, reported where the hook is called, and the refetch and pagination of fragments (`useRefetchableFragment`, `usePaginationFragment`): the query the compiler generates for the fragment's `@refetchable(queryName)` (`refetchQuery`). These hooks send only through the function they return (`sendsThrough`): `const { data } = usePaginationFragment(...)` sends nothing.",
  "package": "relay-runtime",
  "aliases": ["react-relay"],
  "provider": "graphql",
  "host": "{graphqlEndpoint}",
  "auth": "unknown",
  "generatedFrom": "manual (checked against relay-runtime and react-relay 18)",
  "inlinePathLiterals": true,
  "instance": { "names": ["Environment"] },
  "endpoint": {
    "clients": {
      "Environment": { "transport": "0.network" }
    },
    "transports": {
      "Network.create": { "fetchIn": "0" }
    },
    "contextClient": true
  },
  "methods": {
    "useLazyLoadQuery": { "method": "POST", "path": "", "documentArg": 0, "bodyArg": 1 },
    "usePreloadedQuery": { "method": "POST", "path": "", "documentArg": 0 },
    "useMutation": { "method": "POST", "path": "", "documentArg": 0 },
    "useSubscription": { "method": "POST", "path": "", "documentArg": 0, "bodyArg": 0, "bodyProp": "variables", "subscription": true },
    "commitMutation": { "method": "POST", "path": "", "documentArg": 1, "bodyArg": 1, "bodyProp": "variables", "clientArg": "0" },
    "fetchQuery": { "method": "POST", "path": "", "documentArg": 1, "bodyArg": 2, "clientArg": "0" },
    "requestSubscription": { "method": "POST", "path": "", "documentArg": 1, "bodyArg": 1, "bodyProp": "variables", "clientArg": "0", "subscription": true },
    "loadQuery": { "method": "POST", "path": "", "documentArg": 1, "bodyArg": 2, "clientArg": "0" },
    "createRefetchContainer": { "method": "POST", "path": "", "documentArg": 2 },
    "createPaginationContainer": { "method": "POST", "path": "", "documentArg": 2, "documentProp": "query" },
    "useQueryLoader": { "method": "POST", "path": "", "documentArg": 0, "sendsThrough": { "index": 1, "bodyArg": 0 } },
    "useRefetchableFragment": { "method": "POST", "path": "", "documentArg": 0, "refetchQuery": true, "sendsThrough": { "index": 1 } },
    "usePaginationFragment": { "method": "POST", "path": "", "documentArg": 0, "refetchQuery": true, "sendsThrough": { "names": ["loadNext", "loadPrevious", "refetch"] } },
    "useBlockingPaginationFragment": { "method": "POST", "path": "", "documentArg": 0, "refetchQuery": true, "sendsThrough": { "names": ["loadNext", "loadPrevious", "refetch"] } },
    "usePrefetchableForwardPaginationFragment": { "method": "POST", "path": "", "documentArg": 0, "refetchQuery": true, "sendsThrough": { "names": ["loadNext", "refetch"] } }
  },
  "components": {
    "QueryRenderer": { "method": "POST", "path": "", "documentArg": 0, "bodyArg": 1, "clientArg": "2", "props": ["query", "variables", "environment"] }
  }
}
